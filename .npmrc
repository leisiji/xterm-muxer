electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
# Do NOT set omit=optional here: esbuild/rollup/electron ship their platform
# binaries as optionalDependencies, so omitting them breaks the build.
# ssh2's native cpu-features is optional and a build failure there is non-fatal
# (ssh2 falls back to its pure-JS implementation).
