# Read by the *electron package's own* postinstall while `npm install` downloads
# the Electron binary. npm only injects npm_package_config_* from the package
# whose script is running, so putting this in this repo's package.json "config"
# would never reach it and the mirror would silently fall back to GitHub.
# npm warns that unknown project config keys stop working in its next major
# version; when that lands, move this to an ELECTRON_MIRROR environment
# variable, which @electron/get also honours.
electron_mirror=https://npmmirror.com/mirrors/electron/

# NOTE: electron_builder_binaries_mirror deliberately lives in package.json
# "config" instead -- it is read by `npm run dist:*`, a root script, where
# npm_package_config_* IS set. See package.json.

# Do NOT set omit=optional here: esbuild/rollup/electron ship their platform
# binaries as optionalDependencies, so omitting them breaks the build.
# ssh2's native cpu-features is optional and a build failure there is non-fatal
# (ssh2 falls back to its pure-JS implementation).
