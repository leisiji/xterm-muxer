{
  "name": "xterm-muxer",
  "version": "0.1.0",
  "description": "Electron terminal emulator with local multiplexer and SSH support, inspired by wezterm",
  "main": "out/main/index.js",
  "author": "jaron.ye",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:unit": "node scripts/run-test-mux.js",
    "test:sessions": "node scripts/run-test-sessions.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:sessions",
    "rebuild": "node scripts/rebuild-native.js",
    "postinstall": "node scripts/rebuild-native.js",
    "pack": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-unicode11": "^0.6.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
